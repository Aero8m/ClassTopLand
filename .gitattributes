# 所有文本文件由 Git 自动处理换行符
* text=auto

# 源码文件 — 统一使用 LF (Qt/C++ 跨平台标准)
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.ui text eol=lf
*.pro text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.qss text eol=lf
*.qrc text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.rc text eol=lf
*.plist text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell 脚本
*.sh text eol=lf

# SVG — 文本格式
*.svg text eol=lf

# 二进制文件 — 不做任何换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
